# Keep this file in sync with ../.env.example
# You can run backend from rag_qa/ and still use the same keys.

EDURAG_LLM_MODEL=qwen-plus
EDURAG_DASHSCOPE_API_KEY=demo-key-change-me
EDURAG_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EDURAG_COMPARE_LLM_MODEL=auto
EDURAG_COMPARE_API_KEY=demo-key-change-me
EDURAG_COMPARE_BASE_URL=https://example-openai-compatible-provider/v1
EDURAG_DEEPSEEK_API_KEY=demo-key-change-me
EDURAG_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agent / general chat model example using DeepSeek
EDURAG_GENERAL_LLM_MODEL=deepseek-v4-flash
EDURAG_GENERAL_API_KEY=demo-key-change-me
EDURAG_GENERAL_BASE_URL=https://api.deepseek.com

EDURAG_JWT_SECRET=demo-jwt-secret-change-me
EDURAG_DEFAULT_SUPERVISOR_PASSWORD=demo-supervisor-pass-change-me

EDURAG_MINIO_API_HOST_PORT=19000
EDURAG_MINIO_CONSOLE_HOST_PORT=19001
EDURAG_MILVUS_HOST=localhost
EDURAG_MILVUS_PORT=19530
EDURAG_MILVUS_HOST_PORT=19530
