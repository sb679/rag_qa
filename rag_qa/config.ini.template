# 配置说明

本项目使用 `config.ini` 文件管理所有配置项。首次使用前，请复制此模板文件并重命名为 `config.ini`，然后填写您的实际配置信息。

## 配置项说明

### Milvus 向量数据库配置
```ini
[milvus]
host = localhost              # Milvus 主机地址
port = 19530                  # Milvus 端口
database_name = itcast        # 数据库名称
collection_name = edurag_final # 集合名称
```

### LLM 大语言模型配置
```ini
[llm]
model = qwen-plus                        # 模型名称
dashscope_api_key = demo-key-change-me   # DashScope API Key（推荐通过环境变量 EDURAG_DASHSCOPE_API_KEY 注入）
dashscope_base_url = https://dashscope.aliyuncs.com/compatible-mode/v1
compare_llm_model = auto                 # 对比答案模型；auto 表示自动探测可用文本模型
compare_api_key = demo-key-change-me     # 对比答案 API Key（推荐通过环境变量 EDURAG_COMPARE_API_KEY 注入）
compare_base_url = https://example-openai-compatible-provider/v1

# DeepSeek API 配置
deepseek_api_key = demo-key-change-me    # DeepSeek API Key（推荐通过环境变量 EDURAG_DEEPSEEK_API_KEY 注入）
deepseek_base_url = https://api.deepseek.com/v1  # DeepSeek API 基础 URL
```

### 认证配置
```ini
[auth]
jwt_secret = demo-jwt-secret-change-me
default_supervisor_password = demo-supervisor-pass-change-me
```

### 检索参数配置
```ini
[retrieval]
parent_chunk_size = 1200  # 父文档块大小
child_chunk_size = 300    # 子文档块大小
chunk_overlap = 50        # 块重叠大小
chunking_mode = rule      # 可选: rule / hybrid
chunking_mode_by_source = {'default': 'rule', 'mining': 'hybrid'}
struct_min_paragraph_chars = 80
semantic_sim_threshold = 0.74
semantic_min_chunk_size = 220
semantic_max_chunk_size = 520
semantic_model_path = models/bge-m3
retrieval_k = 5           # 检索返回的候选数量
candidate_m = 2           # 最终重排序后的候选数量

[graphrag]
graph_parent_chunk_size = 1600  # 图谱抽取父块大小
graph_child_chunk_size = 500    # 图谱抽取子块大小
graph_chunk_overlap = 100       # 图谱抽取块重叠大小

[ocr]
enable = true
pdf_image_ocr_enable = true
pdf_ocr_min_image_width_ratio = 0.3
pdf_ocr_min_image_height_ratio = 0.3
doc_image_ocr_enable = true
ppt_image_ocr_enable = true

[loader_fallback]
dedoc_fallback_enable = true
```

### 日志配置
```ini
[logger]
log_file = logs/app.log   # 日志文件路径
structured = true
alert_error_threshold = 20
alert_window_sec = 300
```

### 应用配置
```ini
[app]
customer_service_phone = YOUR_PHONE_NUMBER  # 客服电话
valid_sources = ["mining"]                   # 有效的数据源列表

[storage]
# 存储后端：local 或 minio
backend = local

# local 模式下原始文件落盘目录
local_root = user_data/knowledge_files

# minio 模式配置（backend=minio 时生效）
minio_endpoint = 127.0.0.1:9000
minio_access_key = minioadmin
minio_secret_key = minioadmin
minio_bucket = edurag-knowledge
minio_secure = false

[wechat_collector]
# 公众号采集配置（支持按公众号维度单独频率）
source_file = samples/wechat_accounts.sample.json
output_dir = data/wechat_collector/wechat_data
state_file = data/wechat_collector/collector_state.json
request_timeout_sec = 25
default_frequency_days = 30
max_articles_per_account = 500
enable_ocr = true

# 质量阈值
body_pass_threshold = 0.90
ocr_pass_threshold = 0.80
ocr_min_chars_for_index = 8
image_min_side_for_index = 180

# OCR 引擎：auto / paddle / rapid
ocr_engine = auto
paddle_ocr_enable = true

# 疑难图片调用 API 识别（默认关闭以节省成本）
enable_image_api_fallback = false
image_api_min_ocr_chars = 4
image_api_model = qwen-vl-max-latest
image_api_max_calls_per_article = 30
image_api_call_interval_sec = 0.35
image_index_heuristic_threshold = 3
image_high_recall_enable = true
image_enrich_indexable_summary = true

# 页面质量守卫：命中风控页时自动重试，并避免覆盖历史正常结果
page_quality_guard_enable = true
page_guard_max_refetch = 2
page_guard_min_body_chars = 120
page_guard_retry_min_wait_sec = 8
page_guard_retry_max_wait_sec = 18

# 文本结构化（建议开启）
text_struct_enable = true
text_struct_model = qwen-plus
text_struct_max_chars = 6000

# API 超时
api_timeout_sec = 45

# 视频人工标注模板
video_manual_template_enable = true

# 请求标识
user_agent = Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36
```

## 获取 API Key

### DashScope (通义千问)
1. 访问阿里云 DashScope 控制台
2. 注册/登录账号
3. 创建 API Key
4. 将 API Key 填入 `dashscope_api_key`

### DeepSeek
1. 访问 DeepSeek 官网 (https://platform.deepseek.com/)
2. 注册/登录账号
3. 创建 API Key
4. 将 API Key 填入 `deepseek_api_key`

## 注意事项

⚠️ **重要安全提示**：
- 请勿将包含真实 API Key 和密码的 `config.ini` 文件上传到公开代码仓库
- 建议使用环境变量或密钥管理服务来存储敏感信息
- 项目已配置 `.gitignore` 自动忽略 `config.ini` 文件
- 推荐从 `.env.example` 复制为 `.env`，再通过环境变量覆盖敏感配置
